/* GENERAL */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Poppins",sans-serif;
}

body{
    background:#0f0f23;
    color:#fff;
    transition:0.3s;
}

.light{
    background:#f2f2f2;
    color:#111;
}

/* HEADER */
header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 50px;
}

nav a{
    margin-left:30px;
    text-decoration:none;
    color:#bbb;
    transition:0.3s;
}

nav a:hover{
    color:#fff;
}

/* HERO */
.hero{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:80px 50px;
}

.hero-text h1{
    font-size:55px;
}

.hero-text p{
    margin:15px 0 25px;
}

.btn{
    background:#6c63ff;
    padding:12px 22px;
    color:#fff;
    border-radius:6px;
    text-decoration:none;
    display:inline-block;
    transition:0.3s;
}

.btn:hover{
    opacity:0.8;
}

.hero-img img{
    width:270px;
}

/* SECTIONS */
section{
    padding:60px 50px;
}

h2{
    margin-bottom:15px;
    font-size:30px;
}

/* SKILLS */
.skill-tags span{
    padding:8px 14px;
    margin:5px;
    background:#181835;
    border-radius:5px;
    display:inline-block;
}

/* PROJECTS */
.project-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:25px;
}

.project-card{
    background:#181835;
    padding:25px;
    border-radius:10px;
    transition:0.3s;
}

.project-card:hover{
    transform:translateY(-5px);
}

/* CONTACT */
.contact-form{
    width:320px;
    display:flex;
    flex-direction:column;
}

.contact-form input,
.contact-form textarea{
    padding:12px;
    margin-bottom:12px;
    border:none;
    border-radius:5px;
}

/* THEME TOGGLE */
.theme-toggle{
    position:fixed;
    top:20px;
    right:20px;
    background:#6c63ff;
    padding:10px 14px;
    border-radius:50%;
    cursor:pointer;
    font-size:20px;
    z-index:100;
}

/* ANIMATION */
.fade-in{
    opacity:0;
    transform:translateY(20px);
    animation:fadeIn 1s forwards;
}

@keyframes fadeIn{
    to{
        opacity:1;
        transform:translateY(0);
    }
}
